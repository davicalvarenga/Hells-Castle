@page "/"
@using HellsCastle.Core
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Hell's Castle — combate de teste</PageTitle>

<div class="game" tabindex="0" @onkeydown="OnKey">
    <header class="top">
        <h1>Hell's Castle <small>combate de teste</small></h1>
        <div class="controls">
            <div class="mode" role="group" aria-label="Modo de mão">
                <button type="button" class="@(_mode == HandMode.Recompose ? "on" : "")"
                        @onclick="() => SetMode(HandMode.Recompose)">Recompor</button>
                <button type="button" class="@(_mode == HandMode.AutoDraw ? "on" : "")"
                        @onclick="() => SetMode(HandMode.AutoDraw)">Compra automática</button>
            </div>
            <button type="button" class="plain" @onclick="NewCombat">Novo combate</button>
            <button type="button" class="plain" @onclick="ToggleSound" aria-pressed="@(!_muted)">
                Som: @(_muted ? "não" : "sim")
            </button>
        </div>
    </header>

    <main class="layout">
        <section class="board" aria-label="Sala">
            <canvas class="room" @ref="_canvas" aria-label="Sala de combate"></canvas>
        </section>

        <section class="side">
            <div class="status" aria-label="Estado do jogador">
                <div class="stat life">
                    <span class="label">Vida</span>
                    <span class="bar"><i style="width:@Percent(_combat.PlayerHp, _combat.PlayerMaxHp)%"></i></span>
                    <span class="value">@_combat.PlayerHp/@_combat.PlayerMaxHp</span>
                </div>
                <div class="stat-row">
                    <div class="stat"><span class="label">Bloqueio</span><span class="value block">@_combat.Block</span></div>
                    <div class="stat"><span class="label">Cadeia</span><span class="value chain">@_combat.Chain</span></div>
                    <div class="stat"><span class="label">Tique</span><span class="value">@_combat.Tick</span></div>
                </div>
                @if (PlayerDanger is int hitIn)
                {
                    <div class="warn-badge @(hitIn <= 1 ? "now" : "")">Sua casa será atingida em @hitIn</div>
                }
                @if (_combat.OnTheEdge)
                {
                    <div class="edge-badge">Por um fio: próxima carta −1 tique</div>
                }
            </div>

            <div class="timeline" aria-label="Linha do tempo">
                <div class="tl-label">Tiques até cada inimigo agir</div>
                <div class="tl-track">
                    @for (int t = 1; t <= TimelineSlots; t++)
                    {
                        int slot = t;
                        <div class="tl-slot @(SelectedCost >= slot ? "spent" : "")">
                            <span class="tl-num">@slot@(slot == TimelineSlots ? "+" : "")</span>
                            <span class="tl-tokens">
                                @foreach (Enemy enemy in _combat.Enemies)
                                {
                                    if (enemy.IsAlive && Math.Min(enemy.Counter, TimelineSlots) == slot)
                                    {
                                        <img class="portrait" src="@Icon(enemy.Symbol.ToString())" alt="@enemy.Name" />
                                    }
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="enemies" aria-label="Inimigos">
                @foreach (Enemy enemy in _combat.Enemies)
                {
                    <div class="enemy @(enemy.IsAlive ? "" : "dead")">
                        <img class="portrait big" src="@Icon(enemy.Symbol.ToString())" alt="" />
                        <div class="enemy-body">
                            <div class="enemy-head">
                                <strong>@enemy.Name</strong>
                                <span>@(enemy.IsAlive ? enemy.Hp + "/" + enemy.MaxHp : "morto")</span>
                            </div>
                            @if (enemy.IsAlive)
                            {
                                <div class="intent"><b>em @enemy.Counter</b> @enemy.IntentText</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="log" aria-live="polite">
                @foreach ((string text, bool fresh) in VisibleLog())
                {
                    <div class="@(fresh ? "fresh" : "")">@text</div>
                }
            </div>
        </section>
    </main>

    <p class="hint @(_error != null ? "error" : "")">@(_error ?? Hint())</p>

    <section class="hand" aria-label="Mão">
        @for (int i = 0; i < _combat.HandSize; i++)
        {
            int index = i;
            if (index < _combat.Hand.Count)
            {
                CardDefinition card = CardLibrary.Get(_combat.Hand[index]);
                int cost = _combat.EffectiveCost(card.Id);
                <button type="button" class="card @CardKind(card.Id) @(_selected == index ? "selected" : "")"
                        @onclick="() => ClickCard(index)">
                    <span class="cost @(cost < card.Cost ? "discount" : "")"><b>@cost</b></span>
                    <span class="key">@(index + 1)</span>
                    <span class="art"><img src="@Icon(card.Id.ToString())" alt="" /></span>
                    <span class="name">@card.Name</span>
                    <span class="text">@card.Text</span>
                </button>
            }
            else
            {
                <div class="card empty" aria-hidden="true"></div>
            }
        }
    </section>

    <section class="actions">
        <button type="button" @onclick="DoGuard">
            <img src="@Icon("Guardar")" alt="" />
            <span>Guardar <small>2 tiques · bloqueia 2 · tecla G</small></span>
        </button>
        @if (_mode == HandMode.Recompose)
        {
            <button type="button" disabled="@(_combat.Hand.Count >= _combat.HandSize)" @onclick="DoRecompose">
                <img src="@Icon("Recompor")" alt="" />
                <span>Recompor <small>2 tiques · completa a mão · tecla R</small></span>
            </button>
        }
        <span class="piles">monte @_combat.DrawPileCount · descarte @_combat.DiscardCount · semente @_seed</span>
    </section>

    <details class="help">
        <summary>Como jogar</summary>
        <ul>
            <li><b>Não há turnos.</b> Cada ação tem efeito na hora e depois gasta tiques. A cada tique, a contagem dos inimigos cai 1; em zero, o inimigo age.</li>
            <li><b>Andar:</b> toque numa casa vizinha destacada em verde (1 tique). Você nunca recua. Teclas W, A, D.</li>
            <li><b>Cartas:</b> toque na carta e depois na casa destacada em dourado. Aparar é jogada direto. Teclas 1 a 4.</li>
            <li><b>Casas vermelhas:</b> o número é quantos tiques faltam para aquela casa ser atingida. A marca não segue você.</li>
            <li><b>Por um fio:</b> sair de uma casa marcada ou bloquear com a contagem em 1 dá −1 tique na próxima carta.</li>
            <li><b>Cadeia:</b> cartas jogadas desde a última ação de um inimigo. Com 2 ou mais, Varredura e Golpe Pesado ficam mais fortes.</li>
            <li><b>Vitória:</b> a saída só abre com todos os inimigos mortos.</li>
        </ul>
    </details>

    @if (_showResult)
    {
        <div class="overlay">
            <div class="result @(_combat.Status == CombatStatus.Victory ? "win" : "loss")">
                <h2>@(_combat.Status == CombatStatus.Victory ? "Vitória" : "Derrota")</h2>
                <p>@(_combat.Status == CombatStatus.Victory ? "Todos os inimigos caíram. A porta se abre." : "Você caiu antes de abrir a porta.")</p>
                <dl>
                    <dt>Modo de mão</dt><dd>@(_mode == HandMode.Recompose ? "Recompor" : "Compra automática")</dd>
                    <dt>Duração real</dt><dd>@_duration.ToString(@"mm\:ss")</dd>
                    <dt>Tiques</dt><dd>@_combat.Tick</dd>
                    <dt>Vida restante</dt><dd>@_combat.PlayerHp/@_combat.PlayerMaxHp</dd>
                    <dt>Cartas jogadas</dt><dd>@_combat.CardsPlayed</dd>
                    <dt>Maior cadeia</dt><dd>@_combat.BestChain</dd>
                    <dt>Por um fio</dt><dd>@_combat.EdgeCount</dd>
                    <dt>Recompor</dt><dd>@_combat.RecomposeCount</dd>
                    <dt>Guardar</dt><dd>@_combat.GuardCount</dd>
                </dl>
                <div class="result-buttons">
                    <button type="button" @onclick="NewCombat">Novo combate</button>
                    <button type="button" class="plain" @onclick="Replay">Repetir esta semente</button>
                    <button type="button" class="plain" @onclick="ReplayOtherMode">Mesma semente no outro modo</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int TimelineSlots = 6;
    private const int LogLines = 6;

    /// <summary>Tempo para as animações finais terminarem antes de mostrar o resultado.</summary>
    private const int ResultDelayMs = 1200;

    private static readonly Direction[] WalkDirections = { Direction.Forward, Direction.Left, Direction.Right };
    private static readonly Direction[] AllDirections = { Direction.Forward, Direction.Left, Direction.Right, Direction.Back };
    private static readonly Direction[] NoDirections = Array.Empty<Direction>();

    private Combat _combat = default!;
    private HandMode _mode = HandMode.Recompose;
    private int _seed;

    /// <summary>Posição na mão da carta selecionada, aguardando o alvo.</summary>
    private int? _selected;

    /// <summary>Casas clicáveis da carta selecionada e as direções que cada uma representa.</summary>
    private Dictionary<Pos, Direction[]> _targets = new();

    private string? _error;
    private int _logMark;
    private DateTime? _startedAt;
    private TimeSpan _duration;
    private bool _showResult;

    // Ligação com o desenho em canvas (wwwroot/js/game.js).
    private ElementReference _canvas;
    private DotNetObjectReference<Home>? _self;
    private Dictionary<string, string> _icons = new();
    private bool _jsReady;
    private bool _muted;
    private int _eventMark;

    private sealed class InitResult
    {
        public Dictionary<string, string>? Icons { get; set; }
        public bool Muted { get; set; }
    }

    protected override void OnInitialized() => Start(NewSeed(), _mode);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        InitResult result = await JS.InvokeAsync<InitResult>("hellsCastle.init", _canvas, _self);
        _icons = result.Icons ?? new Dictionary<string, string>();
        _muted = result.Muted;
        _jsReady = true;
        await SyncAsync(reset: true);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsReady)
            {
                await JS.InvokeVoidAsync("hellsCastle.dispose");
            }
        }
        catch (JSDisconnectedException)
        {
            // A página já foi fechada.
        }

        _self?.Dispose();
    }

    private static int NewSeed() => Random.Shared.Next(1, 100000);

    private void Start(int seed, HandMode mode)
    {
        _seed = seed;
        _mode = mode;
        _combat = TestRoom.Create(mode, seed);
        _selected = null;
        _targets.Clear();
        _error = null;
        _logMark = 0;
        _eventMark = 0;
        _startedAt = null;
        _duration = TimeSpan.Zero;
        _showResult = false;
    }

    private async Task Restart(int seed, HandMode mode)
    {
        Start(seed, mode);
        await SyncAsync(reset: true);
    }

    private Task NewCombat() => Restart(NewSeed(), _mode);
    private Task Replay() => Restart(_seed, _mode);
    private Task ReplayOtherMode() =>
        Restart(_seed, _mode == HandMode.Recompose ? HandMode.AutoDraw : HandMode.Recompose);

    private Task SetMode(HandMode mode) => mode == _mode ? Task.CompletedTask : Restart(_seed, mode);

    private async Task ToggleSound()
    {
        _muted = !_muted;
        if (_jsReady)
        {
            await JS.InvokeVoidAsync("hellsCastle.setMuted", _muted);
        }
    }

    private bool Playing => _combat.Status == CombatStatus.InProgress;

    private int SelectedCost =>
        _selected is int index && index < _combat.Hand.Count ? _combat.EffectiveCost(_combat.Hand[index]) : 0;

    private int? PlayerDanger => Playing ? _combat.TicksUntilHit(_combat.PlayerPos) : null;

    private string Icon(string name) => _icons.TryGetValue(name, out string? url) ? url : "";

    /// <summary>Classe de cor da carta: ataque, defesa ou movimento.</summary>
    private static string CardKind(CardId id) => id switch
    {
        CardId.Aparar => "def",
        CardId.PassoSombrio => "mov",
        _ => "atk"
    };

    // ---------------------------------------------------------------- ações

    private async Task Run(Func<ActionResult> action)
    {
        if (!Playing)
        {
            return;
        }

        int logBefore = _combat.Log.Count;
        ActionResult result = action();
        _selected = null;
        _targets.Clear();

        if (!result.Success)
        {
            _error = result.Error;
            await SyncAsync();
            return;
        }

        _error = null;
        _logMark = logBefore;
        _startedAt ??= DateTime.UtcNow;
        await SyncAsync();

        if (!Playing)
        {
            _duration = DateTime.UtcNow - _startedAt.Value;
            Combat finished = _combat;
            await Task.Delay(ResultDelayMs);
            if (ReferenceEquals(finished, _combat))
            {
                _showResult = true;
                StateHasChanged();
            }
        }
    }

    private Task DoGuard() => Run(() => _combat.Guard());
    private Task DoRecompose() => Run(() => _combat.Recompose());

    [JSInvokable]
    public async Task OnTileClick(int x, int y)
    {
        await ClickTile(new Pos(x, y));
        StateHasChanged();
    }

    private async Task ClickTile(Pos pos)
    {
        if (!Playing)
        {
            return;
        }

        if (_selected is int index)
        {
            if (_targets.TryGetValue(pos, out Direction[]? directions))
            {
                await Run(() => _combat.PlayCard(index, directions));
            }
            else
            {
                await Cancel();
            }

            return;
        }

        foreach (Direction direction in WalkDirections)
        {
            if (_combat.PlayerPos.Step(direction) == pos && _combat.IsFree(pos))
            {
                await Run(() => _combat.Move(direction));
                return;
            }
        }
    }

    private async Task ClickCard(int index)
    {
        if (!Playing || index >= _combat.Hand.Count)
        {
            return;
        }

        CardDefinition card = CardLibrary.Get(_combat.Hand[index]);

        if (_selected == index)
        {
            // Segundo toque: confirma as cartas de área fixa; cancela as que pedem alvo.
            if (card.Targeting == CardTargeting.None)
            {
                await Run(() => _combat.PlayCard(index));
            }
            else
            {
                await Cancel();
            }

            return;
        }

        // Aparar não toca o mapa: é jogada direto, sem confirmação.
        if (card.Id == CardId.Aparar)
        {
            await Run(() => _combat.PlayCard(index));
            return;
        }

        _error = null;
        _selected = index;
        _targets = BuildTargets(card);
        await SyncAsync();
    }

    private async Task Cancel()
    {
        _selected = null;
        _targets.Clear();
        _error = null;
        await SyncAsync();
    }

    private Dictionary<Pos, Direction[]> BuildTargets(CardDefinition card)
    {
        var targets = new Dictionary<Pos, Direction[]>();
        Pos player = _combat.PlayerPos;

        switch (card.Targeting)
        {
            case CardTargeting.OneDirection:
                foreach (Direction direction in AllDirections)
                {
                    Pos tile = player.Step(direction);
                    if (_combat.IsInside(tile))
                    {
                        targets[tile] = new[] { direction };
                    }
                }

                break;

            case CardTargeting.Path:
                foreach (Direction first in WalkDirections)
                {
                    Pos middle = player.Step(first);
                    if (!_combat.IsFree(middle))
                    {
                        continue;
                    }

                    targets[middle] = new[] { first };
                    foreach (Direction second in WalkDirections)
                    {
                        Pos end = middle.Step(second);
                        if (_combat.IsFree(end))
                        {
                            targets.TryAdd(end, new[] { first, second });
                        }
                    }
                }

                // Um passo direto vale mais que um caminho de dois passos até a mesma casa.
                foreach (Direction direction in WalkDirections)
                {
                    Pos tile = player.Step(direction);
                    if (_combat.IsFree(tile))
                    {
                        targets[tile] = new[] { direction };
                    }
                }

                break;

            default:
                foreach (Pos tile in _combat.CardArea(card.Id))
                {
                    targets[tile] = NoDirections;
                }

                break;
        }

        return targets;
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (!Playing || e.CtrlKey || e.AltKey || e.MetaKey)
        {
            return;
        }

        string key = e.Key.ToLowerInvariant();
        Direction? direction = key switch
        {
            "w" => Direction.Forward,
            "a" => Direction.Left,
            "d" => Direction.Right,
            "s" => Direction.Back,
            _ => null
        };

        if (direction is Direction dir)
        {
            if (_selected is int index)
            {
                if (index < _combat.Hand.Count
                    && CardLibrary.Get(_combat.Hand[index]).Targeting == CardTargeting.OneDirection)
                {
                    await Run(() => _combat.PlayCard(index, dir));
                }
            }
            else if (dir == Direction.Back)
            {
                _error = "Não é possível recuar.";
            }
            else
            {
                await Run(() => _combat.Move(dir));
            }

            return;
        }

        switch (key)
        {
            case "1":
            case "2":
            case "3":
            case "4":
                await ClickCard(key[0] - '1');
                break;
            case "g":
                await DoGuard();
                break;
            case "r":
                if (_mode == HandMode.Recompose)
                {
                    await DoRecompose();
                }

                break;
            case "escape":
                await Cancel();
                break;
        }
    }

    // ---------------------------------------------------------------- envio do estado para o canvas

    private async Task SyncAsync(bool reset = false)
    {
        if (!_jsReady)
        {
            return;
        }

        var events = new List<object>();
        for (int i = _eventMark; i < _combat.Events.Count; i++)
        {
            events.Add(EventDto(_combat.Events[i]));
        }

        _eventMark = _combat.Events.Count;
        await JS.InvokeVoidAsync("hellsCastle.sync", Snapshot(), events, reset);
    }

    private static int[] Xy(Pos pos) => new[] { pos.X, pos.Y };

    private object Snapshot()
    {
        var enemies = new List<object>();
        for (int i = 0; i < _combat.Enemies.Count; i++)
        {
            Enemy enemy = _combat.Enemies[i];
            enemies.Add(new
            {
                id = i,
                kind = enemy.Symbol.ToString(),
                x = enemy.Pos.X,
                y = enemy.Pos.Y,
                hp = enemy.Hp,
                maxHp = enemy.MaxHp,
                alive = enemy.IsAlive,
                counter = enemy.Counter
            });
        }

        var danger = new List<int[]>();
        var walk = new List<int[]>();
        for (int x = 0; x < _combat.Width; x++)
        {
            for (int y = 0; y < _combat.Height; y++)
            {
                var pos = new Pos(x, y);
                if (_combat.TicksUntilHit(pos) is int ticks)
                {
                    danger.Add(new[] { x, y, ticks });
                }

                if (IsWalkTarget(pos))
                {
                    walk.Add(Xy(pos));
                }
            }
        }

        return new
        {
            cols = _combat.Width,
            rows = _combat.Height,
            status = _combat.Status switch
            {
                CombatStatus.Victory => "victory",
                CombatStatus.Defeat => "defeat",
                _ => "playing"
            },
            player = new { x = _combat.PlayerPos.X, y = _combat.PlayerPos.Y },
            enemies,
            danger,
            walk,
            targets = _selected != null ? _targets.Keys.Select(Xy).ToList() : new List<int[]>()
        };
    }

    private static object EventDto(CombatEvent e)
    {
        string name = e.Type.ToString();
        return new
        {
            type = char.ToLowerInvariant(name[0]) + name.Substring(1),
            id = e.EnemyIndex,
            fx = e.From.X,
            fy = e.From.Y,
            tx = e.To.X,
            ty = e.To.Y,
            amount = e.Amount,
            absorbed = e.Absorbed,
            hit = e.Hit,
            pushed = e.Pushed,
            card = e.Card?.ToString(),
            tiles = e.Tiles.Select(Xy).ToList()
        };
    }

    // ---------------------------------------------------------------- apresentação

    private static int Percent(int value, int max) => max <= 0 ? 0 : Math.Clamp(value * 100 / max, 0, 100);

    private bool IsWalkTarget(Pos pos)
    {
        if (!Playing || _selected != null || !_combat.IsFree(pos))
        {
            return false;
        }

        foreach (Direction direction in WalkDirections)
        {
            if (_combat.PlayerPos.Step(direction) == pos)
            {
                return true;
            }
        }

        return false;
    }

    private string Hint()
    {
        if (!Playing)
        {
            return "";
        }

        if (_selected is int index && index < _combat.Hand.Count)
        {
            CardDefinition card = CardLibrary.Get(_combat.Hand[index]);
            return card.Targeting switch
            {
                CardTargeting.OneDirection => card.Name + ": toque na casa vizinha que quer atingir. Esc cancela.",
                CardTargeting.Path => card.Name + ": toque na casa de destino. Esc cancela.",
                _ => card.Name + ": toque de novo na carta, ou na área destacada, para confirmar. Esc cancela."
            };
        }

        return "Toque numa casa vizinha destacada para andar, ou escolha uma carta.";
    }

    private IEnumerable<(string text, bool fresh)> VisibleLog()
    {
        IReadOnlyList<string> log = _combat.Log;
        int from = Math.Max(0, log.Count - LogLines);
        for (int i = from; i < log.Count; i++)
        {
            yield return (log[i], i >= _logMark);
        }
    }
}
