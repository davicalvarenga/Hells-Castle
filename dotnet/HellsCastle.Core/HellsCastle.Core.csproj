<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compila as regras do jogo que ficam em Assets/Scripts/Core (a mesma fonte usada pela Unity),
    para poder rodar os testes e o protótipo de terminal sem abrir o editor.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>HellsCastle.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
